generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id           Int        @id @default(autoincrement())
  firstName    String
  lastName     String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int
}

model OrganizationRole {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  title     String @unique
}
